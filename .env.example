# NyayaAI Environment Configuration
# Copy this file to .env and fill in the values.

# ── LLM settings ───────────────────────────────────────────────────────────────
# Set to "true" to enable LLM-powered responses via Ollama.
# Set to "false" (default) to use the rule-based NoLLM fallback.
USE_LLM=false

# Ollama model identifier (only used when USE_LLM=true)
OLLAMA_MODEL=qwen2.5:3b

# Ollama server base URL
OLLAMA_BASE_URL=http://localhost:11434

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite URL — relative path is resolved from the project root
DB_URL=sqlite+aiosqlite:///./data/nyaya.db

# ── Embedding model ────────────────────────────────────────────────────────────
# Hugging Face model name for sentence-transformers (lazy-loaded singleton)
EMBED_MODEL=all-MiniLM-L6-v2

# ── API ────────────────────────────────────────────────────────────────────────
# Allowed CORS origin for the React dev server
CORS_ORIGIN=http://localhost:5173

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
